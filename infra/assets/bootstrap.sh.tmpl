#!/usr/bin/env bash
set -euo pipefail

export AWS_DEFAULT_REGION={{WORLD_BUCKET_REGION}}

WORLD_BUCKET={{WORLD_BUCKET}}
GAME_STATE_PREFIX={{GAME_STATE_PREFIX}}
WORLD_PREFIX={{WORLD_PREFIX}}
STATE_DIR_PATH={{STATE_DIR_PATH}}
STATE_LINK={{STATE_LINK}}
GAME_NAME={{GAME_NAME}}
SERVICE_USER={{SERVICE_USER}}
GAME_SERVICE={{GAME_SERVICE}}
GAME_HOME={{GAME_HOME}}
GAMECONFIG_S3_KEY={{GAMECONFIG_S3_KEY}}
GAMECONFIG_LOCAL_PATH={{GAMECONFIG_LOCAL_PATH}}
BACKUP_INTERVAL_MINUTES={{BACKUP_INTERVAL_MINUTES}}
BACKUP_BOOT_OFFSET_MINUTES={{BACKUP_BOOT_OFFSET_MINUTES}}
STOP_TIMEOUT_SECONDS={{STOP_TIMEOUT_SECONDS}}
GAME_INSTALL_CMD_B64={{GAME_INSTALL_CMD_B64}}
GAME_START_CMD_B64={{GAME_START_CMD_B64}}
STEAM_BETA_BRANCH={{STEAM_BETA_BRANCH}}
STEAM_BETA_PASSWORD={{STEAM_BETA_PASSWORD}}
GAME_UDP_PORTS={{GAME_UDP_PORTS}}
GAME_TCP_PORTS={{GAME_TCP_PORTS}}
GAME_INGRESS_CIDR={{GAME_INGRESS_CIDR}}
ENFORCE_BOOTSTRAP_LOG_PREFIX={{ENFORCE_BOOTSTRAP_LOG_PREFIX}}
ENFORCE_SERVER_LOG_PREFIX={{ENFORCE_SERVER_LOG_PREFIX}}
AMI_BUILDER_MODE={{AMI_BUILDER_MODE}}
AMI_BUILDER_GAME_ID={{AMI_BUILDER_GAME_ID}}
AMI_BUILDER_BUILD_KEY={{AMI_BUILDER_BUILD_KEY}}
AMI_BUILDER_SCHEMA_VERSION={{AMI_BUILDER_SCHEMA_VERSION}}
AMI_BUILDER_SOURCE_IMAGE_ID={{AMI_BUILDER_SOURCE_IMAGE_ID}}
EC2_INSTANCE_ID="${EC2_INSTANCE_ID:-$(curl -fsS http://169.254.169.254/latest/meta-data/instance-id || true)}"

strip_wrapping_quotes() {
  local value="${1:-}"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  printf '%s' "${value}"
}

AWS_DEFAULT_REGION="$(strip_wrapping_quotes "${AWS_DEFAULT_REGION}")"
WORLD_BUCKET="$(strip_wrapping_quotes "${WORLD_BUCKET}")"
GAME_STATE_PREFIX="$(strip_wrapping_quotes "${GAME_STATE_PREFIX}")"
WORLD_PREFIX="$(strip_wrapping_quotes "${WORLD_PREFIX}")"
STATE_DIR_PATH="$(strip_wrapping_quotes "${STATE_DIR_PATH}")"
STATE_LINK="$(strip_wrapping_quotes "${STATE_LINK}")"
GAME_NAME="$(strip_wrapping_quotes "${GAME_NAME}")"
SERVICE_USER="$(strip_wrapping_quotes "${SERVICE_USER}")"
GAME_SERVICE="$(strip_wrapping_quotes "${GAME_SERVICE}")"
GAME_HOME="$(strip_wrapping_quotes "${GAME_HOME}")"
GAMECONFIG_S3_KEY="$(strip_wrapping_quotes "${GAMECONFIG_S3_KEY}")"
GAMECONFIG_LOCAL_PATH="$(strip_wrapping_quotes "${GAMECONFIG_LOCAL_PATH}")"
GAME_INSTALL_CMD_B64="$(strip_wrapping_quotes "${GAME_INSTALL_CMD_B64}")"
GAME_START_CMD_B64="$(strip_wrapping_quotes "${GAME_START_CMD_B64}")"
STEAM_BETA_BRANCH="$(strip_wrapping_quotes "${STEAM_BETA_BRANCH}")"
STEAM_BETA_PASSWORD="$(strip_wrapping_quotes "${STEAM_BETA_PASSWORD}")"
GAME_INGRESS_CIDR="$(strip_wrapping_quotes "${GAME_INGRESS_CIDR}")"
ENFORCE_BOOTSTRAP_LOG_PREFIX="$(strip_wrapping_quotes "${ENFORCE_BOOTSTRAP_LOG_PREFIX}")"
ENFORCE_SERVER_LOG_PREFIX="$(strip_wrapping_quotes "${ENFORCE_SERVER_LOG_PREFIX}")"
AMI_BUILDER_MODE="$(strip_wrapping_quotes "${AMI_BUILDER_MODE}")"
AMI_BUILDER_GAME_ID="$(strip_wrapping_quotes "${AMI_BUILDER_GAME_ID}")"
AMI_BUILDER_BUILD_KEY="$(strip_wrapping_quotes "${AMI_BUILDER_BUILD_KEY}")"
AMI_BUILDER_SCHEMA_VERSION="$(strip_wrapping_quotes "${AMI_BUILDER_SCHEMA_VERSION}")"
AMI_BUILDER_SOURCE_IMAGE_ID="$(strip_wrapping_quotes "${AMI_BUILDER_SOURCE_IMAGE_ID}")"

decode() {
  printf '%s' "${1}" | base64 -d
}

mkdir -p "/var/log/${GAME_NAME}" "/tmp"
mkdir -p "/opt/${GAME_SERVICE}-tools" "${STATE_DIR_PATH}"
mkdir -p "/etc/systemd/system" "/etc/awslogs" "/var/lib/awslogs"
touch "/var/log/${GAME_NAME}/bootstrap.log" "/var/log/${GAME_NAME}/server.log"
if [[ -n "${EC2_INSTANCE_ID}" ]]; then
  LOG_STREAM_PREFIX="${EC2_INSTANCE_ID}"
else
  LOG_STREAM_PREFIX="$(hostname)-manual"
fi
exec >>"/var/log/${GAME_NAME}/bootstrap.log" 2>&1

launch_phase() {
  local phase="$1"
  local label="$2"
  printf 'LAUNCH_PHASE phase=%s label="%s" at=%s\n' "${phase}" "${label}" "$(date -Is)"
}

launch_phase "bootstrap" "Bootstrapping host"

host_packages_ready=false
baked_ami_marker="/opt/${GAME_SERVICE}-tools/baked-ami-${AMI_BUILDER_SCHEMA_VERSION}"
if command -v aws >/dev/null 2>&1; then
  if [[ "${GAME_SERVICE}" == "windrose" ]] &&
    command -v docker >/dev/null 2>&1 &&
    docker image inspect windroseserver/windroseserver:latest >/dev/null 2>&1; then
    host_packages_ready=true
  elif [[ "${GAME_SERVICE}" == "7d2d" ]] &&
    [[ -n "${AMI_BUILDER_SCHEMA_VERSION}" ]] &&
    [[ -f "${baked_ami_marker}" ]] &&
    [[ -x /opt/steamcmd/steamcmd.sh ]] &&
    [[ -x "${GAME_HOME}/7DaysToDieServer.x86_64" ]]; then
    host_packages_ready=true
  fi
fi

if [[ "${host_packages_ready}" == "true" ]]; then
  echo "Host packages already present for baked ${GAME_NAME} AMI; skipping package update."
  if [[ "${GAME_SERVICE}" == "windrose" ]]; then
    systemctl enable --now docker || true
  fi
elif command -v yum >/dev/null 2>&1; then
  yum -y update
  yum -y install ca-certificates tar gzip curl cronie python3 || true
elif command -v apt-get >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y ca-certificates tar gzip curl cron python3
fi

if [[ "${SERVICE_USER}" == "auto" ]]; then
  if id -u ec2-user >/dev/null 2>&1; then
    SERVICE_USER="ec2-user"
  elif id -u ubuntu >/dev/null 2>&1; then
    SERVICE_USER="ubuntu"
  else
    SERVICE_USER="root"
  fi
fi

if ! id -u "${SERVICE_USER}" >/dev/null 2>&1; then
  SERVICE_USER="root"
fi

DISABLE_STATE_LINK=0
if [[ "${STATE_LINK}" == "__none__" ]]; then
  DISABLE_STATE_LINK=1
  STATE_LINK=""
fi

if [[ -z "${STATE_LINK}" && "${DISABLE_STATE_LINK}" != "1" ]]; then
  SERVICE_USER_HOME="$(getent passwd "${SERVICE_USER}" | cut -d: -f6 || true)"
  if [[ -z "${SERVICE_USER_HOME}" ]]; then
    SERVICE_USER_HOME="/home/${SERVICE_USER}"
  fi
  STATE_LINK="${SERVICE_USER_HOME}/.local/share/7DaysToDie"
else
  STATE_LINK="${STATE_LINK%/}"
fi

if [[ "${DISABLE_STATE_LINK}" != "1" ]]; then
  mkdir -p "${STATE_LINK%/*}"
  mkdir -p "${STATE_LINK%/*}/.local/share"
fi
mkdir -p "${GAME_HOME}"
mkdir -p "/var/log/${GAME_NAME}"
touch "/var/log/${GAME_NAME}/bootstrap.log" \
  "/var/log/${GAME_NAME}/server.log" \
  "/var/log/${GAME_NAME}/server.error.log"
mkdir -p "/etc/systemd/system"
if [[ "${DISABLE_STATE_LINK}" != "1" ]]; then
  ln -sfn "${STATE_DIR_PATH}" "${STATE_LINK}"
fi
mkdir -p "/opt/${GAME_SERVICE}-tools"

if id -u "${SERVICE_USER}" >/dev/null 2>&1; then
  chown_paths=("${STATE_DIR_PATH}" "${GAME_HOME}" "/var/log/${GAME_NAME}")
  if [[ "${DISABLE_STATE_LINK}" != "1" ]]; then
    chown_paths+=("${STATE_LINK%/*}")
  fi
  chown -R "${SERVICE_USER}:${SERVICE_USER}" \
    "${chown_paths[@]}" || true
  chmod -R u+rwX "${STATE_DIR_PATH}" || true
  chmod -R u+rwX "/var/log/${GAME_NAME}" || true
fi

restore_state() {
  if [[ "${GAME_SERVICE}" == "windrose" ]]; then
    mkdir -p "${STATE_DIR_PATH}/Saved"
    aws s3 sync "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/Saved/" "${STATE_DIR_PATH}/Saved/" --exclude "Logs/*" --exclude "Config/CrashReportClient/*" || true
    aws s3 cp "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/config/windrose/ServerDescription.json" "${STATE_DIR_PATH}/ServerDescription.json" || \
      aws s3 cp "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/ServerDescription.json" "${STATE_DIR_PATH}/ServerDescription.json" || true
  else
    aws s3 sync "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/" "${STATE_DIR_PATH}/" || true
  fi
  if [[ -d "${STATE_DIR_PATH}" ]] && [[ -n "${SERVICE_USER}" ]] && id -u "${SERVICE_USER}" >/dev/null 2>&1; then
    chown -R "${SERVICE_USER}:${SERVICE_USER}" "${STATE_DIR_PATH}" || true
    chmod -R u+rwX "${STATE_DIR_PATH}" || true
  fi
}

configure_cloudwatch_agent() {
  local bootstrap_group="${ENFORCE_BOOTSTRAP_LOG_PREFIX}"
  local server_group="${ENFORCE_SERVER_LOG_PREFIX}"
  local stream="${LOG_STREAM_PREFIX}"

  if [[ -z "${bootstrap_group}" || -z "${server_group}" ]]; then
    return 0
  fi

  if ! command -v /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then
    if command -v yum >/dev/null 2>&1; then
      yum -y install amazon-cloudwatch-agent || true
    elif command -v apt-get >/dev/null 2>&1; then
      curl -fsSL https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb -o /tmp/amazon-cloudwatch-agent.deb || true
      dpkg -i /tmp/amazon-cloudwatch-agent.deb || apt-get install -f -y || true
    fi
  fi

  if ! command -v /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then
    echo "CloudWatch Agent is unavailable; skipping log shipping setup."
    return 0
  fi

  mkdir -p /opt/aws/amazon-cloudwatch-agent/etc
  cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<EOF
{
  "agent": {
    "region": "${AWS_DEFAULT_REGION}"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/${GAME_NAME}/bootstrap.log",
            "log_group_name": "${bootstrap_group}",
            "log_stream_name": "${stream}-bootstrap",
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/log/${GAME_NAME}/server.log",
            "log_group_name": "${server_group}",
            "log_stream_name": "${stream}-server",
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/log/${GAME_NAME}/server.error.log",
            "log_group_name": "${server_group}",
            "log_stream_name": "${stream}-server-error",
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "${STATE_DIR_PATH}/Saved/Logs/R5.log",
            "log_group_name": "${server_group}",
            "log_stream_name": "${stream}-server",
            "timestamp_format": "%Y.%m.%d-%H.%M.%S"
          },
          {
            "file_path": "${STATE_DIR_PATH}/R5.log",
            "log_group_name": "${server_group}",
            "log_stream_name": "${stream}-server",
            "timestamp_format": "%Y.%m.%d-%H.%M.%S"
          }
        ]
      }
    }
  }
}

EOF
  /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config -m ec2 -s \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json || true
}

install_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    return 0
  fi

  if command -v yum >/dev/null 2>&1; then
    yum -y install awscli || true
  elif command -v apt-get >/dev/null 2>&1; then
    apt-get install -y awscli || true
  fi
}

upload_state() {
  if [[ "${GAME_SERVICE}" == "windrose" ]]; then
    mkdir -p "${STATE_DIR_PATH}/Saved"
    if command -v docker >/dev/null 2>&1 && docker container inspect WindroseServer >/dev/null 2>&1; then
      docker cp WindroseServer:/home/ue_user/app/R5/ServerDescription.json "${STATE_DIR_PATH}/ServerDescription.json" >/dev/null 2>&1 || true
    fi
    aws s3 sync "${STATE_DIR_PATH}/Saved/" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/Saved/" --delete --exclude "Logs/*" --exclude "Config/CrashReportClient/*" || true
    if [[ -f "${STATE_DIR_PATH}/ServerDescription.json" ]]; then
      aws s3 cp "${STATE_DIR_PATH}/ServerDescription.json" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/ServerDescription.json" || true
      aws s3 cp "${STATE_DIR_PATH}/ServerDescription.json" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/config/windrose/ServerDescription.json" || true
    fi
    world_description="$(find "${STATE_DIR_PATH}/Saved" -type f -name WorldDescription.json 2>/dev/null | head -n 1 || true)"
    if [[ -n "${world_description}" ]] && [[ -f "${world_description}" ]]; then
      aws s3 cp "${world_description}" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/config/windrose/WorldDescription.json" || true
    fi
    return 0
  fi
  aws s3 sync "${STATE_DIR_PATH}/" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/" --delete || true
}

install_game() {
  mkdir -p "${GAME_HOME}"
  install_cmd="$(decode "${GAME_INSTALL_CMD_B64}")"

  if [[ "${GAME_SERVICE}" == "windrose" ]]; then
    if [[ "${AMI_BUILDER_MODE}" != "1" ]] &&
      command -v docker >/dev/null 2>&1 &&
      docker image inspect windroseserver/windroseserver:latest >/dev/null 2>&1; then
      echo "Windrose Docker image already present; skipping profile install command."
      systemctl enable --now docker || true
      return
    fi
    echo "Installing Windrose via profile install command."
    bash -lc "${install_cmd}"
    return
  fi

  mkdir -p /opt/steamcmd "${GAME_HOME%/*}"
  if [[ ! -x /opt/steamcmd/steamcmd.sh ]]; then
    curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz -o /tmp/steamcmd_linux.tar.gz
    tar -xzf /tmp/steamcmd_linux.tar.gz -C /opt/steamcmd
    chmod +x /opt/steamcmd/steamcmd.sh
  fi

  ensure_steamcmd_runtime() {
    if /opt/steamcmd/linux32/steamcmd +quit >/dev/null 2>&1; then
      return 0
    fi

    echo "SteamCMD runtime check failed; attempting to install 32-bit compatibility dependencies."
    if command -v dnf >/dev/null 2>&1; then
      dnf -y install glibc.i686 libgcc.i686 libstdc++.i686 || true
      dnf -y install glibc-devel.i686 libstdc++-devel.i686 || true
    elif command -v yum >/dev/null 2>&1; then
      yum -y install glibc.i686 libgcc.i686 libstdc++.i686 || true
    elif command -v apt-get >/dev/null 2>&1; then
      dpkg --add-architecture i386 || true
      apt-get update || true
      apt-get install -y libc6-i386 libstdc++6:i386 libgcc-s1:i386 || true
      apt-get install -y libc6:i386 libstdc++6:i386 libgcc1:i386 || true
      apt-get install -y libc6:i386 libstdc++6:i386 lib32gcc-s1 || true
      apt-get install -y lib32stdc++6 || true
    fi

    if /opt/steamcmd/linux32/steamcmd +quit >/dev/null 2>&1; then
      return 0
    fi
    return 1
  }

  ensure_steamcmd_runtime || true

  install_branches=( )
  case "${STEAM_BETA_BRANCH}" in
    ""|public|stable|release|default|general|current)
      install_branches+=("")
      ;;
    latest_experimental|latest-experimental|latestexperimental)
      install_branches+=("latest_experimental" "")
      ;;
    experimental|beta)
      install_branches+=("experimental" "")
      ;;
    *)
      install_branches+=("${STEAM_BETA_BRANCH}" "")
      ;;
  esac

  for branch in "${install_branches[@]}"; do
    if [[ -n "${branch}" ]]; then
      STEAM_BETA_BRANCH="${branch}"
    else
      STEAM_BETA_BRANCH=""
    fi
    if STEAM_BETA_BRANCH="${STEAM_BETA_BRANCH}" STEAM_BETA_PASSWORD="${STEAM_BETA_PASSWORD}" bash -lc "${install_cmd}"; then
      return 0
    fi
  done
  return 1
}

install_windrose_monitor() {
  if [[ "${GAME_SERVICE}" != "windrose" ]]; then
    return 0
  fi

  monitor_dir="/opt/windrose-monitor"
  mkdir -p "${monitor_dir}" /var/lib/windrose-monitor
  if [[ -f "${monitor_dir}/windrose_monitor.py" ]]; then
    echo "Windrose monitor already present; refreshing local service wrapper."
  elif curl -fsSL https://codeload.github.com/paulsena/windrose-server-monitor/tar.gz/refs/heads/main -o /tmp/windrose-server-monitor.tar.gz; then
    tar -xzf /tmp/windrose-server-monitor.tar.gz --strip-components=1 -C "${monitor_dir}"
  else
    echo "WARNING: Could not download Windrose monitor; monitor service may not start."
  fi

  python3 - <<'MONITOR_PATCH'
from pathlib import Path

path = Path("/opt/windrose-monitor/windrose_monitor.py")
if not path.exists():
    raise SystemExit(0)
text = path.read_text()
text = text.replace(
    'FOOTER_RE = re.compile(r"^\\s*\\[D:\\\\Source")',
    'FOOTER_RE = re.compile(r"^\\s*\\[D:[\\\\/]Source")',
)
text = text.replace(
    'if "[D:\\\\" in line:  # source-file footer signals end of block',
    'if "[D:\\\\" in line or "[D:/" in line:  # source-file footer signals end of block',
)
text = text.replace(
    'if "[D:\\\\" in line:\n                    end = line.rfind("}")',
    'if "[D:\\\\" in line or "[D:/" in line:\n                    end = line.rfind("}")',
)
if "def load_server_info_from_description()" not in text:
    text = text.replace(
        "def build_api_payload(roster: Roster, known: KnownPlayers, parser: DumpParser) -> dict:\n",
        '''def load_server_info_from_description() -> dict | None:\n    path = os.getenv("WINDROSE_SERVER_DESCRIPTION", "/srv/windrose-state/ServerDescription.json")\n    try:\n        with open(path, "r", encoding="utf-8") as f:\n            data = json.load(f)\n    except (OSError, json.JSONDecodeError):\n        return None\n    desc = data.get("ServerDescription_Persistent", {})\n    if not isinstance(desc, dict):\n        return None\n    return {\n        "server_name": desc.get("ServerName", ""),\n        "max_players": desc.get("MaxPlayerCount", 0),\n        "password_protected": desc.get("IsPasswordProtected", False),\n        "invite_code": desc.get("InviteCode", ""),\n        "world_id": desc.get("WorldIslandId", ""),\n        "deployment_id": data.get("DeploymentId", ""),\n        "direct_connection": {\n            "enabled": desc.get("UseDirectConnection", False),\n            "address": desc.get("DirectConnectionServerAddress", ""),\n            "port": desc.get("DirectConnectionServerPort", -1),\n        },\n    }\n\n\ndef build_api_payload(roster: Roster, known: KnownPlayers, parser: DumpParser) -> dict:\n''',
    )
    text = text.replace(
        "    started, server_info = parser.get_server_state()\n\n    return {\n",
        "    started, server_info = parser.get_server_state()\n    if server_info is None:\n        server_info = load_server_info_from_description()\n\n    return {\n",
    )
path.write_text(text)
MONITOR_PATCH

  cat > /opt/windrose-monitor/run-monitor.sh <<'MONITOR_RUNNER'
#!/usr/bin/env bash
set -euo pipefail

state_dir="${STATE_DIR_PATH:-/srv/windrose-state}"
log_path="${WINDROSE_MONITOR_LOG:-}"
if [[ -z "${log_path}" ]]; then
  while [[ -z "${log_path}" ]]; do
    for candidate in \
      "${state_dir}/Saved/Logs/R5.log" \
      "${state_dir}/Logs/R5.log" \
      "${state_dir}/R5.log"; do
      if [[ -f "${candidate}" ]]; then
        log_path="${candidate}"
        break
      fi
    done
    if [[ -z "${log_path}" ]]; then
      sleep 5
    fi
  done
fi

cd /opt/windrose-monitor
exec /usr/bin/python3 /opt/windrose-monitor/windrose_monitor.py \
  --log "${log_path}" \
  --host 0.0.0.0 \
  --port "${WINDROSE_MONITOR_PORT:-8080}" \
  --state /var/lib/windrose-monitor/player_state.json
MONITOR_RUNNER
  chmod +x /opt/windrose-monitor/run-monitor.sh
}

cat > "/opt/${GAME_SERVICE}-tools/restore-state.sh" <<'EOS'
#!/usr/bin/env bash
set -euo pipefail
WORLD_BUCKET='{{WORLD_BUCKET}}'
WORLD_PREFIX='{{WORLD_PREFIX}}'
STATE_DIR_PATH='{{STATE_DIR_PATH}}'
GAME_SERVICE='{{GAME_SERVICE}}'
if [[ -n "${WORLD_BUCKET}" ]] && [[ -n "${WORLD_PREFIX}" ]]; then
  if [[ "${GAME_SERVICE}" == "windrose" ]]; then
    mkdir -p "${STATE_DIR_PATH}/Saved"
    aws s3 sync "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/Saved/" "${STATE_DIR_PATH}/Saved/" --exclude "Logs/*" --exclude "Config/CrashReportClient/*" || true
    aws s3 cp "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/config/windrose/ServerDescription.json" "${STATE_DIR_PATH}/ServerDescription.json" || \
      aws s3 cp "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/ServerDescription.json" "${STATE_DIR_PATH}/ServerDescription.json" || true
  else
    aws s3 sync "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/" "${STATE_DIR_PATH}/" || true
  fi
fi
EOS

cat > "/opt/${GAME_SERVICE}-tools/upload-state.sh" <<'EOS'
#!/usr/bin/env bash
set -euo pipefail
WORLD_BUCKET='{{WORLD_BUCKET}}'
WORLD_PREFIX='{{WORLD_PREFIX}}'
STATE_DIR_PATH='{{STATE_DIR_PATH}}'
GAME_SERVICE='{{GAME_SERVICE}}'
GAMECONFIG_LOCAL_PATH='{{GAMECONFIG_LOCAL_PATH}}'
GAMECONFIG_S3_KEY='{{GAMECONFIG_S3_KEY}}'
if [[ -n "${WORLD_BUCKET}" ]] && [[ -n "${WORLD_PREFIX}" ]]; then
  if [[ "${GAME_SERVICE}" == "windrose" ]]; then
    mkdir -p "${STATE_DIR_PATH}/Saved"
    if command -v docker >/dev/null 2>&1 && docker container inspect WindroseServer >/dev/null 2>&1; then
      docker cp WindroseServer:/home/ue_user/app/R5/ServerDescription.json "${STATE_DIR_PATH}/ServerDescription.json" >/dev/null 2>&1 || true
    fi
    aws s3 sync "${STATE_DIR_PATH}/Saved/" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/Saved/" --delete --exclude "Logs/*" --exclude "Config/CrashReportClient/*" || true
  else
    aws s3 sync "${STATE_DIR_PATH}/" "s3://${WORLD_BUCKET}/${WORLD_PREFIX}/state/" --delete || true
  fi
fi
if [[ -n "${GAMECONFIG_LOCAL_PATH}" ]] && [[ -n "${GAMECONFIG_S3_KEY}" ]] && [[ -f "${GAMECONFIG_LOCAL_PATH}" ]]; then
  aws s3 cp "${GAMECONFIG_LOCAL_PATH}" "s3://${WORLD_BUCKET}/${GAMECONFIG_S3_KEY}" || true
fi
