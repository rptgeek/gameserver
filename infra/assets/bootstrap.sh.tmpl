ensure_steamclient() {
  local steam_lib="/opt/steamcmd/linux64/steamclient.so"
  if [[ ! -f "${steam_lib}" ]]; then
    steam_lib="/opt/steamcmd/linux32/steamclient.so"
  fi
  if [[ ! -f "${steam_lib}" ]]; then
    return 0
  fi

  local runtime_user="${USER:-$(whoami)}"
  local user_home="${HOME:-}"
  if [[ -z "${user_home}" || ! -d "${user_home}" ]]; then
    user_home="$(getent passwd "${runtime_user}" | cut -d: -f6 || true)"
  fi
  if [[ -n "${user_home}" ]]; then
    mkdir -p "${user_home}/.steam/sdk64"
    ln -sf "${steam_lib}" "${user_home}/.steam/sdk64/steamclient.so"
  fi
}
EOS

run_baked_ami_builder() {
  if [[ "${AMI_BUILDER_MODE}" != "1" ]]; then
    return 1
  fi

  local builder_game_id="${AMI_BUILDER_GAME_ID:-${GAME_SERVICE}}"
  local build_key="${AMI_BUILDER_BUILD_KEY:-default}"
  local schema_version="${AMI_BUILDER_SCHEMA_VERSION:-unknown}"
  local safe_build_key
  safe_build_key="$(printf '%s' "${build_key}" | tr -c 'A-Za-z0-9._-' '-')"
  local timestamp
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  local ami_name="${builder_game_id}-${safe_build_key}-${timestamp}"
  local image_extra_tags=""
  local snapshot_extra_tags=""

  if [[ "${builder_game_id}" == "windrose" ]]; then
    image_extra_tags=",{Key=WindroseDeploymentId,Value=${build_key}},{Key=WindroseDockerImage,Value=windroseserver/windroseserver:latest},{Key=MonitorPatchVersion,Value=2026-07-27-source-footer-v1}"
    snapshot_extra_tags=",{Key=WindroseDeploymentId,Value=${build_key}}"
  elif [[ "${builder_game_id}" == "7d2d" ]]; then
    image_extra_tags=",{Key=SteamBetaBranch,Value=${build_key}}"
  fi

  echo "Preparing ${builder_game_id} baked AMI ${ami_name} from ${EC2_INSTANCE_ID}."
  systemctl stop "${GAME_SERVICE}-server.service" "${GAME_SERVICE}-monitor.service" 2>/dev/null || true
  if [[ -n "${STATE_DIR_PATH}" && -d "${STATE_DIR_PATH}" ]]; then
    find "${STATE_DIR_PATH}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || true
  fi
  mkdir -p "$(dirname "${baked_ami_marker}")"
  touch "${baked_ami_marker}"
  cloud-init clean --logs 2>/dev/null || true
  sync || true

  local ami_id
  ami_id="$(
    aws ec2 create-image \
      --region "${AWS_DEFAULT_REGION}" \
      --instance-id "${EC2_INSTANCE_ID}" \
      --name "${ami_name}" \
      --description "${builder_game_id} baked game-server AMI for ${build_key}" \
      --no-reboot \
      --tag-specifications \
        "ResourceType=image,Tags=[{Key=ManagedBy,Value=7d2d-console},{Key=GameId,Value=${builder_game_id}},{Key=AmiRole,Value=game-server},{Key=AmiBuildKey,Value=${build_key}},{Key=BootstrapSchemaVersion,Value=${schema_version}},{Key=SourceInstanceId,Value=${EC2_INSTANCE_ID}},{Key=SourceImageId,Value=${AMI_BUILDER_SOURCE_IMAGE_ID}},{Key=WorldPrefix,Value=${WORLD_PREFIX}}${image_extra_tags}]" \
        "ResourceType=snapshot,Tags=[{Key=ManagedBy,Value=7d2d-console},{Key=GameId,Value=${builder_game_id}},{Key=AmiRole,Value=game-server},{Key=AmiBuildKey,Value=${build_key}},{Key=SourceInstanceId,Value=${EC2_INSTANCE_ID}}${snapshot_extra_tags}]" \
      --query ImageId \
      --output text
  )"

  echo "Created ${builder_game_id} baked AMI request: ${ami_id}"
  aws ec2 wait image-available --region "${AWS_DEFAULT_REGION}" --image-ids "${ami_id}"
  echo "AMI available: ${ami_id}"

  local old_images
  old_images="$(
    aws ec2 describe-images \
      --region "${AWS_DEFAULT_REGION}" \
      --owners self \
      --filters \
        Name=tag:ManagedBy,Values=7d2d-console \
        Name=tag:GameId,Values="${builder_game_id}" \
        Name=tag:AmiRole,Values=game-server \
        Name=tag:AmiBuildKey,Values="${build_key}" \
      --query "Images[?ImageId!='${ami_id}'].ImageId" \
      --output text
  )"

  for old_image in ${old_images}; do
    echo "Deregistering old ${builder_game_id} baked AMI ${old_image}."
    old_snapshots="$(
      aws ec2 describe-images \
        --region "${AWS_DEFAULT_REGION}" \
        --image-ids "${old_image}" \
        --query 'Images[].BlockDeviceMappings[].Ebs.SnapshotId' \
        --output text 2>/dev/null || true
    )"
    aws ec2 deregister-image --region "${AWS_DEFAULT_REGION}" --image-id "${old_image}" || true
    for snapshot_id in ${old_snapshots}; do
      if [[ -n "${snapshot_id}" && "${snapshot_id}" != "None" ]]; then
        echo "Deleting old ${builder_game_id} baked AMI snapshot ${snapshot_id}."
        aws ec2 delete-snapshot --region "${AWS_DEFAULT_REGION}" --snapshot-id "${snapshot_id}" || true
      fi
    done
  done

  echo "Terminating AMI builder instance ${EC2_INSTANCE_ID}."
  aws ec2 terminate-instances --region "${AWS_DEFAULT_REGION}" --instance-ids "${EC2_INSTANCE_ID}" || true
  shutdown -h now || true
}

