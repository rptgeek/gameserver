WORLD_BUCKET=gameserver-state-example
S3_PREFIX=servers
GAME_NAME=windrose
AWS_REGION=us-east-1
# Use either an explicit AMI ID or an SSM AMI parameter.
AMI_ID=ami-xxxxxxxxxxxxxxxxx
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
SECURITY_GROUP_IDS="sg-xxxxxxxxxxxxxxxxx"

# Windrose dedicated server direct-connection ports.
GAME_UDP_PORTS="7777"
GAME_TCP_PORTS="7777,8080"
GAME_INGRESS_CIDR="0.0.0.0/0"
ENSURE_PROFILE_SECURITY_GROUP_RULES=1

KEY_NAME=example-key
IAM_INSTANCE_PROFILE=example-game-server-role
DEFAULT_INSTANCE_TYPE=c7i.xlarge
VOLUME_SIZE_GIB=80
BACKUP_INTERVAL_MINUTES=5
RECOMMENDED_INSTANCE_TYPES='c7i.large # very budget (2vCPU/4GiB)
c7i.xlarge # baseline (4vCPU/8GiB)
c7i.2xlarge # safer for higher player load (8vCPU/16GiB)'

# WindRose server specifics
STEAM_BETA_BRANCH=""
STEAM_BETA_PASSWORD=""
STATE_DIR_PATH=/srv/windrose-state
STATE_LINK=__none__
GAME_HOME=/opt/windrose
SERVICE_USER=root
GAME_INSTALL_CMD='apt-get update && apt-get install -y docker.io && systemctl enable --now docker && docker pull windroseserver/windroseserver:latest'
GAME_START_CMD='mkdir -p /srv/windrose-state/Saved/Logs /srv/windrose-state/Logs && touch /srv/windrose-state/Saved/Logs/R5.log && if [[ -f /srv/windrose-state/ServerDescription.json ]]; then PUBLIC_IP="$(curl -fsS http://169.254.169.254/latest/meta-data/public-ipv4 || true)" python3 -c "import json,os,pathlib; p=pathlib.Path(\"/srv/windrose-state/ServerDescription.json\"); data=json.loads(p.read_text()); d=data.setdefault(\"ServerDescription_Persistent\",{}); d[\"ServerName\"]=d.get(\"ServerName\") or \"windrose - default\"; d[\"UseDirectConnection\"]=True; d[\"DirectConnectionServerAddress\"]=os.environ.get(\"PUBLIC_IP\",\"\"); d[\"DirectConnectionServerPort\"]=7777; d[\"DirectConnectionProxyAddress\"]=\"0.0.0.0\"; p.write_text(json.dumps(data,indent=2)+\"\\n\")"; fi && chown -R 1000:1000 /srv/windrose-state && chmod -R u+rwX,g+rwX /srv/windrose-state && if docker container inspect WindroseServer >/dev/null 2>&1; then docker rm -f WindroseServer >/dev/null 2>&1 || true; fi && docker_args=(-p 7777:7777/tcp -p 7777:7777/udp -v /srv/windrose-state/Saved:/home/ue_user/app/R5/Saved -v /srv/windrose-state/Logs:/home/ue_user/app/R5/Logs); if [[ -f /srv/windrose-state/ServerDescription.json ]]; then docker_args+=(-v /srv/windrose-state/ServerDescription.json:/home/ue_user/app/R5/ServerDescription.json); fi && exec docker run --name WindroseServer "${docker_args[@]}" windroseserver/windroseserver:latest'
